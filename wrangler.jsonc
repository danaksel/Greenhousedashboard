{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drivhus",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-03-09",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "R2_PUBLIC_BASE_URL": "https://media.danaksel.no"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "GREENHOUSE_DATA",
      "id": "624e218efc3444eb92d78eba02c6a3d7"
    }
  ],
  "r2_buckets": [
    {
      "binding": "GREENHOUSE_HISTORY",
      "bucket_name": "greenhouse-history"
    },
    {
      "binding": "GREENHOUSE_ASSETS",
      "bucket_name": "media"
    }
  ],
  "compatibility_flags": ["nodejs_compat"]
}
